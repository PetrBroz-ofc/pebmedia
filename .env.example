# Zkopírujte do Vercel → Project Settings → Environment Variables
# (soubor .env se do repozitáře necommituje, viz .gitignore)

# --- Přihlášení do administrace ---
ADMIN_PASSWORD=zmen-me-na-silne-heslo
ADMIN_TOKEN_SECRET=nahodny-dlouhy-retezec-pro-podpis-tokenu

# --- Ukládání obsahu z administrace (commit do GitHubu) ---
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=uzivatelske-jmeno-nebo-organizace
GITHUB_REPO=nazev-repozitare
GITHUB_BRANCH=main
CONTENT_PATH=data/content.json

# --- Kontaktní formulář (odesílání e-mailu přes Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=info@pebmedia.cz
CONTACT_FROM_EMAIL=web@pebmedia.cz
# Kam chodí odpovědi zákazníků na e-maily z obchodu (výchozí info.pebmedia@gmail.com)
# REPLY_TO_EMAIL=info.pebmedia@gmail.com

# --- Obchod (vouchery, doplňky, e-booky) ---
# Veřejná adresa webu — použije se v odkazech ve Stripe Checkout a v e-mailech
PUBLIC_BASE_URL=https://pebmedia.cz

# Stripe (Dashboard → Developers → API keys). Začněte vždy v TESTOVACÍM režimu
# (klíče začínající sk_test_...), dokud nebude vše otestované.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# Stripe (Dashboard → Developers → Webhooks → přidat endpoint /api/stripe-webhook
# pro události checkout.session.completed a checkout.session.async_payment_succeeded
# → zkopírovat "Signing secret")
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Náhodný text o délce ALESPOŇ 32 znaků — podepisuje odkazy ke stažení souborů.
# Kratší hodnotu server odmítne. Vygenerujte ho příkazem:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DOWNLOAD_SIGNING_SECRET=

# Vercel Blob (Storage → Create Database → Blob v projektu, přístup PRIVATE!) — token se po
# připojení úložiště vyplní automaticky, sem ho není potřeba ručně opisovat.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# --- Zápis prodaných voucherů do interní správy voucherů (Supabase) ---
# Bez těchto proměnných se zápis přeskočí. Service role klíč je TAJNÝ: jen do Vercelu jako Secret.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxxxxxxxxxx
